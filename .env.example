# Copy to .env and adjust. Every setting has a safe default (src/ipl_lakehouse/config.py).
# Read by the Makefile and by docker compose. Keep comments on their own lines.

# ---------------------------------------------------------------- storage
# Lakehouse root (bronze/silver/gold/ops). Containers always use /data.
IPL_DATA_DIR=./data
# Streaming checkpoints; defaults to $IPL_DATA_DIR/_checkpoints
# IPL_CHECKPOINT_DIR=./data/_checkpoints

# ---------------------------------------------------------------- source (Cricsheet)
IPL_CRICSHEET_URL=https://cricsheet.org/downloads/ipl_json.zip
IPL_CRICSHEET_REGISTER_URL=https://cricsheet.org/register/people.csv
IPL_HTTP_TIMEOUT_SECONDS=60
IPL_HTTP_RETRIES=5
# IPL_HTTP_USER_AGENT=ipl-streaming-lakehouse/0.1

# ---------------------------------------------------------------- spark
IPL_SPARK_MASTER=local[*]
IPL_SPARK_DRIVER_MEMORY=2g
IPL_SPARK_SHUFFLE_PARTITIONS=8
IPL_SPARK_UI_ENABLED=false
IPL_SPARK_LOG_LEVEL=WARN
# Pre-fetched Delta/Kafka jars instead of Maven resolution (set in the Docker image)
# IPL_SPARK_JARS_DIR=/opt/spark-jars

# ---------------------------------------------------------------- kafka
# From the host against the compose broker use localhost:9094
IPL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
IPL_KAFKA_TOPIC=ipl.deliveries.v1
IPL_KAFKA_TOPIC_PARTITIONS=6
IPL_KAFKA_REPLICATION_FACTOR=1
IPL_KAFKA_TOPIC_RETENTION_MS=604800000
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
IPL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 (required for SASL_*)
# IPL_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# IPL_KAFKA_SASL_USERNAME=
# IPL_KAFKA_SASL_PASSWORD=
# Only used when the ingest query has no checkpoint yet
IPL_KAFKA_STARTING_OFFSETS=earliest
IPL_KAFKA_MAX_OFFSETS_PER_TRIGGER=10000
IPL_KAFKA_FAIL_ON_DATA_LOSS=true

# ---------------------------------------------------------------- streaming
IPL_STREAM_TRIGGER_SECONDS=5
IPL_STREAM_WATERMARK=2 minutes
IPL_STREAM_ACTIVITY_WINDOW=1 minute
IPL_STREAM_DQ_FAIL_ON_ERROR=true

# ---------------------------------------------------------------- replay producer
# 60 replays a ~3.5 h match in ~3.5 min; 0 sends as fast as possible
IPL_REPLAY_SPEEDUP=60
IPL_REPLAY_SECONDS_PER_BALL=35
IPL_REPLAY_INNINGS_BREAK_SECONDS=1200
# Season replayed by `docker compose run --rm producer`
# IPL_REPLAY_SEASON=2025

# ---------------------------------------------------------------- batch / observability
IPL_DQ_FAIL_ON_ERROR=true
IPL_LOG_LEVEL=INFO
# json | text
IPL_LOG_FORMAT=json
